{
  "$schema": "https://raw.githubusercontent.com/martinheidegger/color-json/main/draft/schema.json",
  "name": "sireen-design-tokens",
  "version": "1.0.0",
  "description": "Machine-readable design tokens for SIREEN AI Security IDE",
  "colors": {
    "semantic": {
      "background": {
        "sidebar": { "value": "var(--vscode-sideBar-background)", "description": "Main sidebar background" },
        "sectionHeader": { "value": "var(--vscode-sideBar-sectionHeader-background)", "description": "Section header backgrounds" },
        "editor": { "value": "var(--vscode-editor-background)", "description": "Code editor background" },
        "input": { "value": "var(--vscode-input-background)", "description": "Input field backgrounds" },
        "dropdown": { "value": "var(--vscode-dropdown-background)", "description": "Dropdown menu backgrounds" },
        "badge": { "value": "var(--vscode-badge-background)", "description": "Status badge backgrounds" }
      },
      "foreground": {
        "sidebar": { "value": "var(--vscode-sideBar-foreground)", "description": "Primary sidebar text" },
        "editor": { "value": "var(--vscode-editor-foreground)", "description": "Editor/code text" },
        "input": { "value": "var(--vscode-input-foreground)", "description": "Form input text" },
        "description": { "value": "var(--vscode-descriptionForeground)", "description": "Helper text and descriptions" },
        "separator": { "value": "var(--vscode-textSeparator-foreground)", "description": "Divider lines" }
      },
      "border": {
        "sidebar": { "value": "var(--vscode-sideBar-border)", "description": "Sidebar panel borders" },
        "input": { "value": "var(--vscode-input-border)", "description": "Form input borders" },
        "dropdown": { "value": "var(--vscode-dropdown-border)", "description": "Dropdown menu borders" },
        "widget": { "value": "var(--vscode-widget-border)", "description": "Widget/dialog borders" }
      },
      "interactive": {
        "button": {
          "background": { "value": "var(--vscode-button-background)", "description": "Primary button background" },
          "foreground": { "value": "var(--vscode-button-foreground)", "description": "Primary button text" },
          "secondaryBackground": { "value": "var(--vscode-button-secondaryBackground)", "description": "Secondary button background" },
          "secondaryForeground": { "value": "var(--vscode-button-secondaryForeground)", "description": "Secondary button text" }
        },
        "list": {
          "hover": { "value": "var(--vscode-list-hoverBackground)", "description": "List item hover state" },
          "selected": { "value": "var(--vscode-list-activeSelectionBackground)", "description": "List item selected state" },
          "focusOutline": { "value": "var(--vscode-list-focusOutline)", "description": "Keyboard focus ring" }
        },
        "focusBorder": { "value": "var(--vscode-focusBorder)", "description": "Focus indicator color" }
      },
      "severity": {
        "critical": { "value": "var(--vscode-errorForeground)", "description": "Critical severity color" },
        "high": { "value": "var(--vscode-warningForeground)", "description": "High severity color" },
        "medium": { "value": "var(--vscode-notificationInfoForeground)", "description": "Medium severity color" },
        "low": { "value": "var(--vscode-charts-orange)", "description": "Low severity color" },
        "informational": { "value": "var(--vscode-textPreformat-foreground)", "description": "Informational text color" }
      }
    },
    "brand": {
      "amber": {
        "value": "#F59E0B",
        "description": "Primary accent for actions and highlights",
        "usage": "Interactive elements only"
      },
      "purple": {
        "value": "#A855F7",
        "description": "Security-specific feature accent",
        "usage": "Contract tabs, security features"
      },
      "cyan": {
        "value": "#06B6D4",
        "description": "Simulation status indicator",
        "usage": "Live status dots, terminal output"
      },
      "green": {
        "value": "#22C55E",
        "description": "Success and confirmation states",
        "usage": "Verified badges, success messages"
      }
    }
  },
  "typography": {
    "fontFamily": {
      "ui": {
        "value": "system-ui, -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, 'Helvetica Neue', Arial, sans-serif",
        "description": "Primary font stack for all UI text"
      },
      "monospace": {
        "value": "'JetBrains Mono', 'Fira Code', 'Cascadia Code', 'Hack', Consolas, 'Courier New', monospace",
        "description": "Font stack for code blocks and terminal output"
      }
    },
    "fontSize": {
      "caption": { "value": "10px", "description": "Timestamps, breadcrumbs, metadata" },
      "small": { "value": "11px", "description": "Helper text, inline code" },
      "body": { "value": "12px", "description": "Default body text" },
      "large": { "value": "13px", "description": "Chat messages, descriptions" },
      "code": { "value": "13px", "description": "Code block text" },
      "h4": { "value": "12px", "description": "Card titles, item headers" },
      "h3": { "value": "13px", "description": "Subsection titles" },
      "h2": { "value": "14px", "description": "Section titles" },
      "h1": { "value": "16px", "description": "Panel titles (rare)" }
    },
    "fontWeight": {
      "regular": { "value": "400", "description": "Regular weight" },
      "medium": { "value": "500", "description": "Medium weight for buttons, labels" },
      "semibold": { "value": "600", "description": "Semibold for headings" }
    },
    "lineHeight": {
      "ui": { "value": "1.3", "description": "UI text line height (VS Code standard)" },
      "code": { "value": "1.6", "description": "Code text line height" },
      "compact": { "value": "1.2", "description": "Compact text (metadata)" },
      "loose": { "value": "1.4", "description": "Loose text (descriptions)" }
    }
  },
  "spacing": {
    "scale": {
      "1": { "value": "4px", "description": "Tight spacing" },
      "2": { "value": "8px", "description": "Standard spacing" },
      "3": { "value": "12px", "description": "Medium spacing" },
      "4": { "value": "16px", "description": "Large spacing" },
      "5": { "value": "20px", "description": "Extra large spacing (rare)" },
      "6": { "value": "24px", "description": "Page-level spacing (very rare)" }
    }
  },
  "radius": {
    "sm": { "value": "2px", "description": "Small radius for inputs, badges" },
    "md": { "value": "4px", "description": "Medium radius for buttons, cards" },
    "lg": { "value": "6px", "description": "Large radius for modals (rare)" },
    "full": { "value": "9999px", "description": "Full radius for pills, avatars" }
  },
  "elevation": {
    "base": {
      "value": "none",
      "description": "No shadow for base panels"
    },
    "elevated": {
      "value": "none",
      "border": "1px solid var(--vscode-widget-border)",
      "description": "Border-based elevation"
    },
    "overlay": {
      "value": "0 2px 8px rgba(0, 0, 0, 0.25)",
      "description": "Subtle shadow for dropdowns"
    },
    "modal": {
      "value": "0 4px 16px rgba(0, 0, 0, 0.35)",
      "description": "Stronger shadow for modals"
    }
  },
  "animation": {
    "duration": {
      "fast": { "value": "0.15s", "description": "Micro-interactions (hover, focus)" },
      "normal": { "value": "0.2s", "description": "Standard transitions (collapse)" },
      "slow": { "value": "0.3s", "description": "Longer animations (progress bars)" },
      "spin": { "value": "1s", "description": "Continuous loops (spinners)" }
    },
    "ease": {
      "default": { "value": "ease", "description": "Default easing function" },
      "linear": { "value": "linear", "description": "Linear easing (spinners)" }
    }
  },
  "icons": {
    "source": "codicon",
    "import": "https://cdn.jsdelivr.net/npm/@vscode/codicons@0.0.35/dist/codicon.css",
    "sizes": {
      "sm": { "value": "12px", "description": "Small icons (badges)" },
      "md": { "value": "16px", "description": "Default icons" },
      "lg": { "value": "24px", "description": "Large icons (empty states)" }
    }
  }
}

# Sireen Backend Environment Variables

# OpenRouter API key (optional — enables LLM-assisted reasoning.
# Without it, SIREEN runs in heuristic mode. This secret belongs to the
# backend ONLY; it is never sent to or requested by any UI.)
OPENROUTER_API_KEY=sk-or-v1-your-key-here

# Qdrant (optional, defaults to localhost:6333)
QDRANT_HOST=localhost
QDRANT_PORT=6333

SIREEN_BACKEND_URL=http://localhost:7432

# SIREEN backend configuration
# Copy to .env.local and fill in. .env.local is git-ignored — never commit real keys.

# ---------------------------------------------------------------------------
# OPTIONAL — LLM-assisted hypothesis generation (OpenRouter).
# Leave EMPTY to run fully offline in HEURISTIC mode.
# When set, contract source and analysis prompts are sent to OpenRouter.
# This is the only outbound call SIREEN makes in normal operation.
# ---------------------------------------------------------------------------
OPENROUTER_API_KEY=

# ---------------------------------------------------------------------------
# OPTIONAL — Qdrant vector memory for abstract pattern recall.
# Leave as-is for a local instance; SIREEN works without it.
# ---------------------------------------------------------------------------
QDRANT_HOST=localhost
QDRANT_PORT=6333

# ---------------------------------------------------------------------------
# Local backend address used by the VS Code extension.
# ---------------------------------------------------------------------------
SIREEN_BACKEND_URL=http://127.0.0.1:7432

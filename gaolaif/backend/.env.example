# Sireen Backend Environment Variables

# OpenRouter API key (required for LLM calls)
OPENROUTER_API_KEY=sk-or-v1-your-key-here

# Qdrant (optional, defaults to localhost:6333)
QDRANT_HOST=localhost
QDRANT_PORT=6333

# Supabase (optional, for subscription system)
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# NOWPayments (optional, for payment system)
NOWPAYMENTS_API_KEY=
NOWPAYMENTS_IPN_SECRET=
SIREEN_BACKEND_URL=http://localhost:7432

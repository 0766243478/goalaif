# SIREEN backend configuration
# Copy to .env.local and fill in. .env.local is git-ignored — never commit real keys.

# ---------------------------------------------------------------------------
# OPTIONAL — LLM-assisted hypothesis generation (OpenRouter).
# Leave EMPTY to run fully offline in HEURISTIC mode.
# When set, contract source and analysis prompts are sent to OpenRouter.
# This is the only outbound call SIREEN makes in normal operation.
# ---------------------------------------------------------------------------
OPENROUTER_API_KEY=

# ---------------------------------------------------------------------------
# OPTIONAL — Qdrant vector memory for abstract pattern recall.
# Leave as-is for a local instance; SIREEN works without it.
# ---------------------------------------------------------------------------
QDRANT_HOST=localhost
QDRANT_PORT=6333

# ---------------------------------------------------------------------------
# Local backend address used by the VS Code extension.
# ---------------------------------------------------------------------------
SIREEN_BACKEND_URL=http://127.0.0.1:7432

# ---------------------------------------------------------------------------
# OPTIONAL — Local API authentication.
# When SIREEN_API_TOKEN is set (or a token file exists), every REST endpoint
# except /health and /config/status requires `Authorization: Bearer <token>`,
# and the WebSocket requires `?token=<token>`. The extension reads the same
# value from the `gaolaif.apiToken` setting or this env var.
# Leave EMPTY for a loopback-only dev setup with auth disabled.
# ---------------------------------------------------------------------------
SIREEN_API_TOKEN=

# Escape hatch: set to 1 to disable the auth gate entirely (loopback dev only).
# A warning is logged at startup whenever the gate is disabled.
SIREEN_AUTH_DISABLED=0

# ---------------------------------------------------------------------------
# OPTIONAL — Memory backend selection.
#   auto   (default) use Qdrant when reachable, otherwise in-process memory
#   qdrant require Qdrant; fail loudly if it is unreachable
#   memory keep patterns in-process only; nothing is persisted
#   off    disable recall entirely; save and search are no-ops
# ---------------------------------------------------------------------------
SIREEN_MEMORY_MODE=auto

# ---------------------------------------------------------------------------
# OPTIONAL — Override the SQLite audit store location (useful for tests/CI).
# ---------------------------------------------------------------------------
# SIREEN_DB_PATH=/absolute/path/to/sireen.db

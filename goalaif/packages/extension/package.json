{
  "name": "goalaif",
  "displayName": "GoalAIF — AI Security Workspace",
  "description": "AI-powered smart contract security auditing for Web3 developers and ethical hackers",
  "version": "0.1.0",
  "publisher": "goalaif",
  "license": "BSL-1.1",
  "engines": { "vscode": "^1.85.0" },
  "categories": ["Security", "Debuggers", "Programming Languages"],
  "keywords": ["solidity", "security", "audit", "exploit", "web3", "smart-contracts"],
  "activationEvents": [],
  "main": "./out/extension.js",
  "contributes": {
    "commands": [
      { "command": "goalaif.analyzeDefensive", "title": "GoalAIF: Analyze Protocol Security (Defensive)" },
      { "command": "goalaif.analyzeOffensive", "title": "GoalAIF: Analyze for Exploit (Offensive)" },
      { "command": "goalaif.runPoC", "title": "GoalAIF: Run PoC in Sandbox" },
      { "command": "goalaif.generateReport", "title": "GoalAIF: Generate Bug Bounty Report" },
      { "command": "goalaif.openSidebar", "title": "GoalAIF: Open Sidebar Panel" }
    ],
    "keybindings": [
      { "command": "goalaif.analyzeDefensive", "key": "ctrl+alt+d", "mac": "cmd+alt+d" },
      { "command": "goalaif.analyzeOffensive", "key": "ctrl+alt+x", "mac": "cmd+alt+x" },
      { "command": "goalaif.openSidebar", "key": "ctrl+alt+g", "mac": "cmd+alt+g" }
    ],
    "menus": {
      "editor/context": [
        { "command": "goalaif.analyzeDefensive", "group": "goalaif@1" },
        { "command": "goalaif.analyzeOffensive", "group": "goalaif@2" }
      ]
    }
  },
  "scripts": {
    "vscode:prepublish": "npm run compile",
    "compile": "tsc -p ./",
    "watch": "tsc -watch -p ./",
    "package": "vsce package"
  },
  "devDependencies": {
    "@types/vscode": "^1.85.0",
    "typescript": "^5.4.0"
  },
  "dependencies": {}
}
